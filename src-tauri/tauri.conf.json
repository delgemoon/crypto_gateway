{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "order_dashboard",
  "version": "0.1.0",
  "identifier": "com.tamdang.orderdashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Order Dashboard",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "additionalBrowserArgs": "--js-flags=--max-old-space-size=512 --max-semi-space-size=64"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
